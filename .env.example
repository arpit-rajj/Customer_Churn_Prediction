# Database Configuration
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=churn_password
POSTGRES_DB=churn_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database URL
# Used by FastAPI app to connect to the database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Local Database URL (for local scripts outside Docker)
LOCAL_DATABASE_URL=postgresql://churn_user:churn_password@localhost:5432/churn_db

# Model Configuration
MODEL_DIR=models
MODEL_VERSION=rf-v1
